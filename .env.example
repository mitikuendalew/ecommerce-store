DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop?schema=public"
# At least 32 random chars: openssl rand -base64 48
JWT_SECRET=""
# Shared secret used to verify payment webhook signatures
PAYMENT_WEBHOOK_SECRET=""
STORE_CURRENCY="USD"
SHIPPING_FLAT_CENTS="500"
FREE_SHIPPING_OVER_CENTS="10000"
TAX_RATE="0"
# Used only by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123"

# ── Frontend ──
NEXT_PUBLIC_STORE_NAME="Storefront"
NEXT_PUBLIC_CURRENCY="USD"      # keep equal to STORE_CURRENCY
# Server-side fetches from pages need an absolute URL to the API (same app by default)
API_URL="http://localhost:3000"
